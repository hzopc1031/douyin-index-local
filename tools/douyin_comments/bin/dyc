#!/usr/bin/env python3
"""Thin local wrapper: optional user-systemd scope, then python -m dyc."""
import os
from pathlib import Path
import shutil
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
python = os.environ.get("DYC_PYTHON") or (str(root / ".venv/bin/python")
                                         if (root / ".venv/bin/python").exists() else sys.executable)
# Keep filesystem arguments (and relative environment overrides) relative to
# the caller, including when systemd-run re-executes the command.
os.environ["PYTHONPATH"] = str(root) + (os.pathsep + os.environ["PYTHONPATH"]
                                       if os.environ.get("PYTHONPATH") else "")
command = [python, "-m", "dyc", *sys.argv[1:]]
if (os.environ.get("DYC_USE_SCOPE") == "1" and not os.environ.get("DYC_NO_SCOPE")
        and not os.environ.get("DYC_IN_SCOPE")):
    available = False
    if shutil.which("systemd-run") and shutil.which("systemctl"):
        try:
            probe = subprocess.run(["systemctl", "--user", "show-environment"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            available = probe.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            pass
    if available:
        os.environ["DYC_IN_SCOPE"] = "1"
        os.execvp("systemd-run", ["systemd-run", "--user", "--scope", "--quiet",
                                 "-p", "MemoryMax=1500M", *command])
    print("dyc: user systemd scope unavailable; memory cap is not enforced", file=sys.stderr)
os.execvp(python, command)
