[Unit]
Description=Douyin index cloud desktop
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=douyin-svc
Group=douyin-svc
WorkingDirectory=/srv/work-ecs-projects/douyin-index-local
ExecStart=/usr/bin/dbus-run-session -- /bin/bash /srv/work-ecs-projects/douyin-index-local/tencent-desktop.sh
Restart=on-failure
RestartSec=10
Environment=INDEX_HUB_STATE_DIR=/var/lib/douyin-index
Environment=INDEX_HUB_LOG_DIR=/var/log/douyin-index
# 扫码登录（步骤 ③）。改回 desktop 即恢复远程桌面登录；两个单元必须一致。
Environment=INDEX_HUB_LOGIN_MODE=qr
# 有头 Chromium 复用本单元 tencent-desktop.sh 启动的 Xvfb（DISPLAY=:107），不另开 Xvfb。
Environment=INDEX_HUB_QR_BROWSER=headed
# root 安装、只读即可；ProtectSystem=strict 下无需加入 ReadWritePaths。临时 profile 在 PrivateTmp 的 /tmp。
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Code and .runtime (Qt libraries) stay read-only for the service account.
ReadWritePaths=/var/lib/douyin-index /var/log/douyin-index /srv/work-ecs-projects/douyin-index-local/.cloud-home /srv/work-ecs-projects/douyin-index-local/results
LimitCORE=0
TasksMax=1024
KillMode=control-group
[Install]
WantedBy=multi-user.target
