[Unit]
Description=Douyin index cloud gateway
After=network-online.target douyin-index-desktop.service
Wants=network-online.target douyin-index-desktop.service
[Service]
Type=simple
User=douyin-svc
Group=douyin-svc
WorkingDirectory=/srv/work-ecs-projects/douyin-index-local
ExecStart=/bin/bash /srv/work-ecs-projects/douyin-index-local/tencent-gateway.sh
Restart=on-failure
RestartSec=10
Environment=INDEX_HUB_STATE_DIR=/var/lib/douyin-index
Environment=INDEX_HUB_LOG_DIR=/var/log/douyin-index
# 推荐靠防火墙只放行 tailscale0；不要在前面加反向代理（所有客户端会变成同一个 IP，认证限流会失效）。
#Environment=INDEX_HUB_BIND=100.x.y.z
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Code and .runtime (Qt libraries) stay read-only for the service account.
ReadWritePaths=/var/lib/douyin-index /var/log/douyin-index
LimitCORE=0
TasksMax=1024
KillMode=control-group
[Install]
WantedBy=multi-user.target
