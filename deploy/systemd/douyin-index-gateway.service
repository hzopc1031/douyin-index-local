[Unit]
Description=Douyin index cloud gateway
After=network-online.target douyin-index-desktop.service
Wants=network-online.target douyin-index-desktop.service
[Service]
Type=simple
User=work-tencent-manager
Group=work-tencent-manager
WorkingDirectory=/srv/work-ecs-projects/douyin-index-local
ExecStart=/bin/bash /srv/work-ecs-projects/douyin-index-local/tencent-gateway.sh
Restart=on-failure
SuccessExitStatus=143
RestartSec=10
Environment=INDEX_HUB_LOG_DIR=/srv/work-ecs-projects/douyin-index-local/logs
# 推荐：只监听 Tailscale 地址或 127.0.0.1（配合反向代理），而不是 0.0.0.0。
#Environment=INDEX_HUB_BIND=100.x.y.z
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/work-ecs-projects/douyin-index-local
LimitCORE=0
TasksMax=1024
KillMode=control-group
[Install]
WantedBy=multi-user.target
